# =============================================================================
# Environment variables for the Virona ShawQ Dashboard.
#
# Convention used in this file:
#   NAME=            -> must be supplied per deployment (set it in Railway).
#                       Left blank here because the value is a credential or
#                       environment-specific.
#   NAME=value       -> a safe default you may override.
#
# This file covers deploy-time configuration only. Tuning knobs that already
# have sensible in-code defaults (SESSION_INTELLIGENCE_VERIFIER_*,
# SI_INVESTIGATION_*, CUSTOMER_INSIGHTS_BUNDLE_*/MOMENTUM_*, and similar
# thresholds/timeouts) are deliberately NOT listed — they are read with a
# fallback at their point of use, and setting them blank here would override
# a working default with an empty string.
# =============================================================================

# Core
# IMPORTANT (prod): mount a persistent volume at /data and set:
# - PERSISTENT_DATA_DIR=/data (recommended), or
# - DATABASE_PATH=/data/dashboard.db
DATABASE_PATH=./data/dashboard.db
PERSISTENT_DATA_DIR=
PORT=3001
# Public origin of this dashboard, used to build absolute pixel/callback URLs.
# On Railway this is the service's public domain, e.g. https://<app>.up.railway.app
APP_BASE_URL=
# Alternative persistent-volume path (Render-style). PERSISTENT_DATA_DIR is
# preferred on Railway; set only one.
RENDER_DISK_PATH=

# Puppeteer / Chromium (headless browser used by Landing Page Audit,
# Session Intelligence verification, and the investigation browser probe)
PUPPETEER_CACHE_DIR=/app/.cache/puppeteer
# Set when Chromium is provided by the image rather than downloaded,
# e.g. /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# VironaX (Salla-backed store)
VIRONAX_META_AD_ACCOUNT_ID=
VIRONAX_META_ACCESS_TOKEN=
VIRONAX_META_PIXEL_ID=
VIRONAX_SALLA_ACCESS_TOKEN=
VIRONAX_SALLA_STORE=
VIRONAX_SALLA_ACCOUNT=
# Storefront origin, used for store profiling and browser probes.
VIRONAX_STORE_URL=

# Shawq (Shopify-backed store)
# The Meta and Shopify credentials below are shared with the standalone
# ShawqAds service, which uses the same names. Keep them in sync — rotating
# the Meta or Shopify token in one place requires updating the other.
SHAWQ_META_AD_ACCOUNT_ID=
SHAWQ_META_ACCESS_TOKEN=
SHAWQ_SHOPIFY_STORE=
SHAWQ_SHOPIFY_ACCESS_TOKEN=
SHAWQ_META_PIXEL_ID=
# Storefront origin, used for store profiling and browser probes.
SHAWQ_STORE_URL=
# Internal store key used to scope per-store env lookups. Defaults to "shawq";
# changing it also changes which STORE_TIMEZONE_<KEY> variable is read.
SHAWQ_STORE_KEY=shawq

# Default (unscoped) Meta credentials
# Used for any store that is not "shawq", and by the demographics/analytics
# paths that read the unscoped names.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PIXEL_ID=
# Graph API version. ShawqAds pins this to the same value; leaving it unset
# means different modules fall back to different versions (v19.0 vs v20.0).
META_GRAPH_VERSION=v20.0


# Shopify App (OAuth)
SHOPIFY_APP_KEY=
SHOPIFY_APP_SECRET=
SHOPIFY_APP_SCOPES=read_orders,read_customers,read_products
# Optional: separate encryption key for stored Shopify tokens (recommended)
SHOPIFY_TOKEN_SECRET=
# Aliases of SHOPIFY_APP_SECRET. Session Intelligence falls back to these when
# resolving its signing secret, so set at least one of them (or the dedicated
# SESSION_INTELLIGENCE_SIGNING_SECRET below).
SHOPIFY_API_SECRET=
SHOPIFY_API_SECRET_KEY=

# Shopify multi-store resolution
# Store key used when a request does not name one. Defaults to SHAWQ_STORE_KEY,
# then to "shawq".
SHOPIFY_DEFAULT_STORE_KEY=
# Optional JSON map of alias -> canonical store key,
# e.g. {"shawq.co":"shawq","virona":"vironax"}
SHOPIFY_STORE_ALIAS_MAP=

# Store timezones (IANA TZ names)
# Resolved per store as STORE_TIMEZONE_<STORE_KEY>, falling back to
# STORE_TIMEZONE_DEFAULT. ShawqAds carries the same value under the names
# SHAWQ_META_REPORTING_TIMEZONE / SHAWQ_SHOPIFY_REPORTING_TIMEZONE.
STORE_TIMEZONE_DEFAULT=UTC
STORE_TIMEZONE_VIRONAX=Asia/Riyadh
# Europe/Istanbul — matches the reporting timezone reported by both the Shawq
# Meta ad account and the Shawq Shopify store.
STORE_TIMEZONE_SHAWQ=Europe/Istanbul

# Session Intelligence — signing + admin access
# IMPORTANT (prod): the signing secret resolves through this ordered list:
#   SESSION_INTELLIGENCE_SIGNING_SECRET, SESSION_INTELLIGENCE_ACCESS_SECRET,
#   SESSION_SECRET, COOKIE_SECRET, SHOPIFY_API_SECRET, SHOPIFY_API_SECRET_KEY
# Outside production an insecure development fallback is used, but when
# NODE_ENV=production and none of them are set the secret resolves to an empty
# string and survey-link signing silently stops working. Set at least one.
SESSION_INTELLIGENCE_SIGNING_SECRET=
SESSION_INTELLIGENCE_ACCESS_SECRET=
SESSION_SECRET=
COOKIE_SECRET=
# Guards the Session Intelligence admin endpoints. Either name works.
SESSION_INTELLIGENCE_ADMIN_ACCESS_KEY=
SESSION_INTELLIGENCE_ADMIN_API_KEY=

# Blackbox / pixel attribution
# Salt used to hash visitor IPs before storage. Set a long random value and do
# not rotate it casually — changing it breaks continuity of hashed identities.
BLACKBOX_IP_HASH_SALT=

# Customer Insights
CUSTOMER_INSIGHTS_MIN_SEGMENT_ORDERS=

# Meta App (OAuth / auth flows)
META_APP_ID=
META_APP_SECRET=
META_TOKEN_SECRET=

# Meta campaign launcher security
# Required to call POST /api/meta/campaign-launcher
META_CAMPAIGN_LAUNCHER_API_KEY=
# Optional allowlists (comma-separated ad account IDs, with or without act_ prefix)
META_ALLOWED_AD_ACCOUNT_IDS=
VIRONAX_META_ALLOWED_AD_ACCOUNT_IDS=
SHAWQ_META_ALLOWED_AD_ACCOUNT_IDS=

# Google Ads / Keyword Planner
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Optional: path to OAuth client secret JSON (web/installed). If set, client_id/client_secret can be loaded from this file.
GOOGLE_OAUTH_CLIENT_SECRET_PATH=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v22
# Client auto-refresh interval for Google mode in milliseconds (minimum 15000)
VITE_GOOGLE_ADS_AUTO_REFRESH_MS=60000

# Search demand
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_API_KEY=
SEMRUSH_API_KEY=
AHREFS_API_KEY=

# Social intent
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
TIKTOK_API_KEY=

# Marketplace data (often via vendors/scrapers)
AMAZON_MARKETPLACE_DATA_KEY=
NOON_MARKETPLACE_DATA_KEY=
MARKETPLACE_DATA_PROVIDER=

# Pricing intelligence
PRICE_INTEL_API_KEY=
PRICE_INTEL_SCRAPER_URL=

# Macro + geo
WORLD_BANK_API_KEY=
IMF_API_KEY=
HOLIDAYS_API_KEY=
WEATHER_API_KEY=
CURRENCYFREAKS_API_KEY=
OXR_APP_ID=
APILAYER_EXCHANGE_RATES_KEY=
# TRY->USD sources. Frankfurter (ECB) is the default and needs no key or quota; days the
# ECB does not publish (weekends/holidays) reuse the previous published day's rate.
EXCHANGE_RATE_DAILY_PROVIDER=frankfurter
EXCHANGE_RATE_BACKFILL_PRIMARY_PROVIDER=frankfurter
EXCHANGE_RATE_BACKFILL_SECONDARY_PROVIDER=
EXCHANGE_RATE_BOOTSTRAP_DAYS=730
EXCHANGE_RATE_BOOTSTRAP_MAX_DAYS=3650
EXCHANGE_RATE_BACKFILL_MAX_CALLS=100

# Shipping / tax rules
SHIPPING_RATE_API_KEY=
TAX_RATE_API_KEY=

# Web traffic / app installs
SIMILARWEB_API_KEY=
DATA_AI_API_KEY=
SENSOR_TOWER_API_KEY=

# Misc integrations already used in repo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-pro-preview
VIDEO_OVERLAY_SCAN_MODEL=
APIFY_API_TOKEN=
# Optional: overrides the default Apify actor used for scraping runs.
APIFY_CUSTOM_ACTOR_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UNSIGNED_UPLOAD_PRESET=
REPLICATE_API_TOKEN=
PHOTO_MAGIC_REPLICATE_MODEL=black-forest-labs/flux-fill-pro
PHOTO_MAGIC_REPLICATE_ENHANCE_MODEL=bria/increase-resolution
PHOTO_MAGIC_REPLICATE_BACKGROUND_PROMPT=premium studio background, natural floor grounding, clean commercial lighting, realistic depth, and seamless subject integration
PHOTO_MAGIC_REPLICATE_TIMEOUT_MS=300000
PHOTO_MAGIC_PUBLIC_BASE_URL=
PHOTO_MAGIC_REPLICATE_EXPAND_MAX_SIDE=2048
PHOTO_MAGIC_REPLICATE_ENHANCE_MAX_SIDE=2048
VIDEO_MAGIC_REPLICATE_CLEAN_MODEL=bria/video-erase-object
VIDEO_MAGIC_REPLICATE_REMOVE_BG_MODEL=bria/video-remove-background
VIDEO_MAGIC_REPLICATE_ENHANCE_MODEL=bria/video-increase-resolution

# Fireworks Open Models (GLM-5 / Kimi K2.5)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_DEFAULT_MODEL=accounts/fireworks/models/glm-5
FIREWORKS_MAX_OUTPUT_TOKENS=4096

# Landing Page Audit — Puppeteer sandbox override
# Set to 1 when running inside containers/CI where Chromium sandbox is unavailable.
# The fetcher auto-falls back to HTTP-only mode if Puppeteer fails, so this is optional.
LPA_PUPPETEER_NO_SANDBOX=0

# Sibling AI microservices
# Each of these has its own directory in this repo and deploys as a separate
# Railway service. Point them at the private domain of the corresponding
# service, e.g. http://photo-magic-ai.railway.internal:PORT
# Left unset, the dependent feature is skipped (or falls back to localhost,
# which will not resolve in a container).
PHOTO_MAGIC_AI_URL=
PHOTO_MAGIC_AI_TOKEN=
PHOTO_MAGIC_HQ_AI_URL=
PHOTO_MAGIC_HQ_TOKEN=
PRODUCT_RADAR_AI_URL=
VIDEO_OVERLAY_AI_URL=
CREATIVE_INTELLIGENCE_API_BASE_URL=
# Defaults to http://localhost:5060 / :5050 — override in Railway.
GROUNDING_DINO_SERVICE_URL=
SCRFD_SERVICE_URL=

# Insights model services (non-LLM)
INSIGHTS_MODEL_TIMEOUT_MS=6000
INSIGHTS_CREATIVE_EMBED_SERVICE_URL=
INSIGHTS_GEO_SIM_SERVICE_URL=
INSIGHTS_ADJACENT_SERVICE_URL=
INSIGHTS_FORECAST_SERVICE_URL=

# Insights model tuning (defaults: heavy models OFF)
MODEL_CACHE_MAX=64
ENABLE_DEEPSURV_TRAIN=0
MIN_CREATIVES_FOR_DEEPSURV=10
MIN_EVENTS_FOR_DEEPSURV=6
ENABLE_TABPFN=0
ENABLE_SIAMESE_TRAIN=0
MIN_GEOS_FOR_TABPFN=6
MIN_GEOS_FOR_SIAMESE=10
ENABLE_GRAPHSAGE=0
ENABLE_SASREC=0
MIN_ITEMS_FOR_GRAPHSAGE=200
MIN_SESSIONS_FOR_SASREC=5000

# Insights model tuning

# Forecast service (Chronos-2)
CHRONOS_MODEL_ID=amazon/chronos-t5-small
CHRONOS_PRED_LEN=21
